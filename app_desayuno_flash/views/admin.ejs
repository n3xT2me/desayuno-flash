<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Centro de Control Admin | Flash</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- Alpine.js para pestañas y acordeones fáciles -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'sans-serif'] },
                    colors: {
                        brand: { bg: '#F4F3FA', shell: '#F9F9FD', sidebar: '#F5F4FA', accent: '#16a34a', lightAccent: '#dcfce7', textPrimary: '#20202A', textSecondary: '#737486', muted: '#A3A4B4', card: '#FFFFFF' }
                    }
                }
            }
        }
    </script>
    <style>
        body { background-color: #F4F3FA; background-image: linear-gradient(135deg, #F4F3FA 0%, #FFFFFF 100%); }
        .glass-card { background: rgba(255, 255, 255, 0.72); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.7); }
        .logo-bubble:hover { transform: scale(1.1) rotate(5deg); }
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-thumb { background: #E2E1E9; border-radius: 10px; }
    </style>
</head>
<body class="flex items-center justify-center min-h-screen text-brand-textPrimary">
    <div class="bg-brand-shell flex w-full h-screen overflow-hidden" x-data="{ tab: 'pedidos' }">
        
        <!-- Sidebar -->
        <aside class="w-[64px] bg-brand-sidebar flex flex-col items-center py-5 justify-between border-r border-white">
            <div class="flex flex-col items-center gap-8">
                <a href="/" class="logo-bubble w-[40px] h-[40px] rounded-full bg-gradient-to-tr from-brand-accent to-green-400 flex items-center justify-center shadow-md">
                    <i class="fa-solid fa-leaf text-white absolute text-sm transform -translate-x-1 translate-y-1 opacity-90"></i>
                    <i class="fa-solid fa-bolt text-yellow-300 absolute text-lg transform translate-x-1 -translate-y-1"></i>
                </a>
                <nav class="flex flex-col gap-[18px] text-brand-muted">
                    <button @click="tab = 'pedidos'" :class="{ 'bg-white text-brand-accent shadow-sm rounded-xl': tab === 'pedidos' }" class="w-10 h-10 hover:bg-white hover:text-brand-accent flex items-center justify-center transition rounded-xl" title="Dashboard">
                        <i class="fa-solid fa-chart-pie"></i>
                    </button>
                    <button @click="tab = 'restaurantes'" :class="{ 'bg-white text-brand-accent shadow-sm rounded-xl': tab === 'restaurantes' }" class="w-10 h-10 hover:bg-white hover:text-brand-accent flex items-center justify-center transition rounded-xl" title="Restaurantes">
                        <i class="fa-solid fa-store"></i>
                    </button>
                    <button @click="tab = 'usuarios'" :class="{ 'bg-white text-brand-accent shadow-sm rounded-xl': tab === 'usuarios' }" class="w-10 h-10 hover:bg-white hover:text-brand-accent flex items-center justify-center transition rounded-xl" title="Usuarios">
                        <i class="fa-solid fa-users"></i>
                    </button>
                </nav>
            </div>
            <div class="flex flex-col gap-4 text-brand-muted">
                <a href="/logout" class="w-10 h-10 rounded-xl hover:bg-red-50 text-red-400 flex items-center justify-center transition"><i class="fa-solid fa-arrow-right-from-bracket"></i></a>
            </div>
        </aside>

        <!-- Main Workspace -->
        <main class="flex-1 flex flex-col overflow-hidden">
            <header class="h-[58px] flex items-center justify-end px-6 border-b border-gray-100/50">
                <div class="flex items-center gap-5 text-brand-textSecondary">
                    <span class="text-sm font-bold"><%= user.name %> (Admin)</span>
                    <div class="w-8 h-8 rounded-full bg-brand-accent text-white flex items-center justify-center font-bold text-xs"><%= user.name.charAt(0) %></div>
                </div>
            </header>

            <div class="flex-1 overflow-y-auto p-[20px] lg:p-[40px]">
                <div class="w-full max-w-[1600px] mx-auto">
                    
                    <!-- TAB 1: DASHBOARD Y PEDIDOS -->
                    <div x-show="tab === 'pedidos'" x-transition>
                        <h1 class="text-2xl font-extrabold text-gray-900 mb-8">Centro de Control de Envíos</h1>
                        
                        <div class="flex flex-col lg:flex-row gap-6 h-full">
                            
                            <!-- Left: Métricas y Tabla -->
                            <div class="flex-1 flex flex-col gap-6">
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                    <div class="glass-card rounded-[14px] p-6 flex flex-col">
                                        <h3 class="font-bold text-sm mb-3">Recaudación Yape/Plin</h3>
                                        <span class="text-5xl font-extrabold text-brand-accent">S/ <%= (stats.total_ventas || 0).toFixed(2) %></span>
                                        <span class="text-sm font-semibold mt-2 text-gray-500"><%= stats.total_pedidos %> pedidos generados</span>
                                    </div>
                                    <div class="glass-card rounded-[14px] p-6 flex flex-col justify-center">
                                        <h3 class="font-bold text-sm mb-3">Estado de Operación</h3>
                                        <div class="flex gap-4">
                                            <div class="flex-1 bg-yellow-50 p-3 rounded-xl border border-yellow-100 text-center">
                                                <div class="text-xl font-bold text-yellow-600"><%= totales.preparando %></div>
                                                <div class="text-[10px] uppercase font-bold text-yellow-600 mt-1">En Cocina</div>
                                            </div>
                                            <div class="flex-1 bg-blue-50 p-3 rounded-xl border border-blue-100 text-center">
                                                <div class="text-xl font-bold text-blue-600"><%= totales.en_ruta %></div>
                                                <div class="text-[10px] uppercase font-bold text-blue-600 mt-1">En Ruta</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="glass-card rounded-[20px] p-6 flex-1">
                                    <h3 class="text-lg font-bold text-gray-900 mb-4">Registro Histórico</h3>
                                    <div class="overflow-x-auto">
                                        <table class="w-full text-left border-collapse min-w-[600px]">
                                            <thead>
                                                <tr class="text-xs text-brand-muted border-b border-gray-100">
                                                    <th class="pb-3 font-medium"># DF</th>
                                                    <th class="pb-3 font-medium">Cliente</th>
                                                    <th class="pb-3 font-medium">Entrega</th>
                                                    <th class="pb-3 font-medium">Pago</th>
                                                    <th class="pb-3 font-medium">Estado</th>
                                                </tr>
                                            </thead>
                                            <tbody class="text-sm">
                                                <% orders.forEach(function(order) { %>
                                                <tr class="border-b border-gray-50 last:border-none">
                                                    <td class="py-3 text-xs text-gray-500 font-bold">DF-<%= order.id.toString().padStart(4, '0') %></td>
                                                    <td class="py-3 font-semibold text-gray-800"><%= order.customer_name %></td>
                                                    <td class="py-3 text-gray-600 text-xs"><%= order.scheduled_time %><br><%= order.delivery_address %></td>
                                                    <td class="py-3">
                                                        <% if(order.payment_status === 'Aprobado') { %>
                                                            <span class="text-green-600 font-bold text-xs"><i class="fa-solid fa-check-circle"></i> Aprobado</span>
                                                        <% } else { %>
                                                            <span class="text-yellow-600 font-bold text-xs"><i class="fa-solid fa-clock"></i> Pendiente</span>
                                                        <% } %>
                                                    </td>
                                                    <td class="py-3 font-bold text-xs"><%= order.status %></td>
                                                </tr>
                                                <% }); %>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                            <!-- Right: Gestión Activa -->
                            <div class="w-full lg:w-[350px] flex flex-col gap-4">
                                <h3 class="font-bold text-lg text-gray-900">Gestión en Curso</h3>
                                <div class="space-y-4 overflow-y-auto max-h-[70vh] pr-2">
                                    <% orders.filter(o => o.status !== 'Entregado').forEach(order => { %>
                                    <div class="glass-card p-4 rounded-[14px] border border-gray-200">
                                        <div class="flex justify-between items-center mb-3">
                                            <span class="font-bold text-xs bg-gray-100 px-2 py-1 rounded">Pedido #<%= order.id %></span>
                                            <span class="font-bold text-brand-accent text-sm">S/ <%= order.total_price.toFixed(2) %></span>
                                        </div>
                                        <p class="text-xs font-bold mb-1"><i class="fa-solid fa-user text-gray-400"></i> <%= order.customer_name %> (<%= order.customer_phone %>)</p>
                                        
                                        
                                        <!-- Unified form for order updates -->
                                        <form action="/admin/pedido/<%= order.id %>/actualizar-todo" method="POST" class="mt-3 bg-gray-50 p-3 rounded-lg border border-gray-100 flex flex-col gap-3">
                                            <div class="flex justify-between items-center">
                                                <span class="text-[10px] font-bold text-gray-400 uppercase tracking-wider">Pago</span>
                                                <select name="payment_status" class="text-xs font-bold bg-white border outline-none cursor-pointer p-1 rounded <%= order.payment_status === 'Aprobado' ? 'text-green-600' : 'text-yellow-600' %>">
                                                    <option value="Pendiente" <%= order.payment_status === 'Pendiente' ? 'selected' : '' %>>Pendiente Validar</option>
                                                    <option value="Aprobado" <%= order.payment_status === 'Aprobado' ? 'selected' : '' %>>¡Pago Recibido!</option>
                                                </select>
                                            </div>
                                            
                                            <div class="flex justify-between items-center">
                                                <span class="text-[10px] font-bold text-gray-400 uppercase tracking-wider"><i class="fa-solid fa-motorcycle mr-1"></i> Repartidor</span>
                                                <select name="driver_name" class="text-xs font-bold bg-white border outline-none cursor-pointer text-blue-600 p-1 rounded max-w-[120px]">
                                                    <option value="">(Sin asignar)</option>
                                                    <% drivers.forEach(d => { %>
                                                        <option value="<%= d.name %>" <%= order.driver_name === d.name ? 'selected' : '' %>><%= d.name %></option>
                                                    <% }) %>
                                                </select>
                                            </div>

                                            <div class="pt-3 border-t border-gray-100">
                                                <span class="text-[10px] font-bold text-gray-400 uppercase tracking-wider mb-2 block">Estado del Pedido</span>
                                                <select name="status" class="w-full text-xs font-bold bg-white border border-gray-200 rounded p-2 outline-none text-[#555568] cursor-pointer hover:bg-gray-100 transition mb-2">
                                                    <option value="Pendiente" <%= order.status === 'Pendiente' ? 'selected' : '' %>>Pendiente</option>
                                                    <option value="Aprobado" <%= order.status === 'Aprobado' ? 'selected' : '' %>>Aprobado</option>
                                                    <option value="Preparando" <%= order.status === 'Preparando' ? 'selected' : '' %>>Preparando</option>
                                                    <option value="Listo" <%= order.status === 'Listo' ? 'selected' : '' %>>Listo</option>
                                                    <option value="Repartidor Asignado" <%= order.status === 'Repartidor Asignado' ? 'selected' : '' %>>Repartidor Asignado</option>
                                                    <option value="En Camino" <%= order.status === 'En Camino' ? 'selected' : '' %>>En Camino</option>
                                                    <option value="Entregado" <%= order.status === 'Entregado' ? 'selected' : '' %>>Entregado</option>
                                                </select>
                                                
                                                <button type="submit" class="w-full bg-[#16a34a] hover:bg-green-700 text-white font-bold py-2 rounded text-xs transition flex items-center justify-center gap-2 mt-2 shadow-md">
                                                    <i class="fa-solid fa-floppy-disk"></i> Guardar Cambios
                                                </button>
                                            </div>
                                        </form>

                                    </div>
                                    <% }) %>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- TAB 2: RESTAURANTES Y MENÚS -->
                    <div x-show="tab === 'restaurantes'" style="display: none;" x-transition>
                        <h1 class="text-2xl font-extrabold text-gray-900 mb-8">Gestión de Restaurantes y Catálogo</h1>
                        <div class="space-y-4">
                            <% restaurants.forEach(rest => { %>
                            <div class="glass-card rounded-[14px] overflow-hidden" x-data="{ open: false }">
                                <div @click="open = !open" class="flex justify-between items-center p-5 cursor-pointer hover:bg-gray-50 transition border-b border-gray-100">
                                    <div class="flex items-center gap-4">
                                        <img src="<%= rest.image_url %>" class="w-12 h-12 rounded-lg object-cover">
                                        <div>
                                            <h3 class="font-bold text-gray-900"><%= rest.name %></h3>
                                            <p class="text-xs text-brand-textSecondary"><%= rest.tags %></p>
                                        </div>
                                    </div>
                                    <div class="text-brand-muted">
                                        <i class="fa-solid fa-chevron-down transition-transform" :class="open ? 'rotate-180' : ''"></i>
                                    </div>
                                </div>
                                <div x-show="open" class="p-6 bg-gray-50/50" x-transition>
                                    <h4 class="text-xs font-bold uppercase tracking-widest text-brand-accent mb-4">Menú Activo</h4>
                                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                        <% products.filter(p => p.restaurant_id === rest.id).forEach(prod => { %>
                                        <div class="bg-white p-3 rounded-xl border border-gray-200 shadow-sm flex gap-3 items-center">
                                            <img src="<%= prod.image_url %>" class="w-14 h-14 rounded-lg object-cover">
                                            <div>
                                                <p class="text-sm font-bold"><%= prod.name %></p>
                                                <p class="text-[10px] text-gray-500"><%= prod.calories %> kcal</p>
                                                <p class="text-xs font-extrabold text-brand-accent mt-1">S/ <%= prod.price.toFixed(2) %></p>
                                            </div>
                                        </div>
                                        <% }) %>
                                    </div>
                                </div>
                            </div>
                            <% }) %>
                        </div>
                    </div>

                    <!-- TAB 3: USUARIOS Y MEMBRESÍAS -->
                    <div x-show="tab === 'usuarios'" style="display: none;" x-transition>
                        <h1 class="text-2xl font-extrabold text-gray-900 mb-8">Base de Datos de Usuarios y Membresías</h1>
                        <div class="glass-card rounded-[20px] p-6 shadow-sm border border-gray-100">
                            <div class="overflow-x-auto">
                                <table class="w-full text-left border-collapse min-w-[800px]">
                                    <thead>
                                        <tr class="text-xs text-brand-muted border-b border-gray-100">
                                            <th class="pb-3 font-medium">Usuario</th>
                                            <th class="pb-3 font-medium">Correo</th>
                                            <th class="pb-3 font-medium">Rol</th>
                                            <th class="pb-3 font-medium">Tipo Membresía</th>
                                            <th class="pb-3 font-medium">Estado</th>
                                            <th class="pb-3 font-medium text-right">Acciones</th>
                                        </tr>
                                    </thead>
                                    <tbody class="text-sm">
                                        <% users.forEach(u => { %>
                                        <tr class="border-b border-gray-50 last:border-none">
                                            <td class="py-4 font-bold text-gray-800"><%= u.name %></td>
                                            <td class="py-4 text-gray-600"><%= u.email %></td>
                                            <td class="py-4"><span class="px-2 py-1 bg-gray-100 rounded text-[10px] font-bold uppercase"><%= u.role %></span></td>
                                            <td class="py-4">
                                                <form action="/admin/membresia/<%= u.id %>/actualizar" method="POST" class="flex gap-2 items-center">
                                                    <select name="membership_type" class="text-xs bg-gray-50 border border-gray-200 rounded p-1 outline-none">
                                                        <option value="Ninguna" <%= u.membership_type === 'Ninguna' ? 'selected' : '' %>>Ninguna</option>
                                                        <option value="Plan Estudiante" <%= u.membership_type === 'Plan Estudiante' ? 'selected' : '' %>>Estudiante</option>
                                                        <option value="Plan Ejecutivo Fit" <%= u.membership_type === 'Plan Ejecutivo Fit' ? 'selected' : '' %>>Ejecutivo</option>
                                                    </select>
                                                    <select name="membership_status" class="text-xs bg-gray-50 border border-gray-200 rounded p-1 outline-none">
                                                        <option value="Inactiva" <%= u.membership_status === 'Inactiva' ? 'selected' : '' %>>Inactiva</option>
                                                        <option value="Activa" <%= u.membership_status === 'Activa' ? 'selected' : '' %>>Activa</option>
                                                    </select>
                                                    <button type="submit" class="text-brand-accent hover:text-green-700 text-xs font-bold" title="Guardar"><i class="fa-solid fa-save"></i></button>
                                                </form>
                                            </td>
                                            <td class="py-4">
                                                <% if(u.membership_status === 'Activa') { %>
                                                    <span class="text-green-600 font-bold text-xs"><i class="fa-solid fa-circle-check"></i> Activa</span>
                                                <% } else { %>
                                                    <span class="text-gray-400 font-bold text-xs"><i class="fa-solid fa-circle-xmark"></i> Inactiva</span>
                                                <% } %>
                                            </td>
                                            <td class="py-4 text-right">
                                                <% if(u.role !== 'admin') { %>
                                                <form action="/admin/usuario/<%= u.id %>/eliminar" method="POST" onsubmit="return confirm('¿Seguro que deseas eliminar este usuario?');">
                                                    <button type="submit" class="text-red-500 hover:text-red-700 transition"><i class="fa-solid fa-trash"></i></button>
                                                </form>
                                                <% } else { %>
                                                    <span class="text-[10px] text-gray-400">Protegido</span>
                                                <% } %>
                                            </td>
                                        </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </main>
    </div>
</body>
</html>
