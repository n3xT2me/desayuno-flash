<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login | Flash</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;800&display=swap" rel="stylesheet">
    <style>body { font-family: 'Plus Jakarta Sans', sans-serif; }</style>
</head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen p-4">
    <div class="bg-white p-8 rounded-3xl shadow-xl w-full max-w-md border border-gray-100">
        <div class="text-center mb-8">
            <h1 class="text-3xl font-extrabold text-gray-900">Bienvenido de nuevo.</h1>
            <p class="text-gray-500 text-sm mt-2">Ingresa a tu cuenta Flash.</p>
        </div>
        <% if(error) { %>
            <div class="bg-red-50 text-red-600 text-sm p-3 rounded-lg mb-6 text-center font-semibold"><%= error %></div>
        <% } %>
        <form action="/login" method="POST" class="space-y-5">
            <div>
                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">Correo Electrónico</label>
                <input type="email" name="email" required class="w-full bg-gray-50 border-0 rounded-xl p-4 focus:ring-2 focus:ring-black">
            </div>
            <div>
                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">Contraseña</label>
                <input type="password" name="password" required class="w-full bg-gray-50 border-0 rounded-xl p-4 focus:ring-2 focus:ring-black">
            </div>
            <button type="submit" class="w-full bg-black text-white font-bold py-4 rounded-xl mt-4 hover:bg-gray-800 transition">Ingresar</button>
        </form>
        <p class="text-center text-sm text-gray-500 mt-6">¿No tienes cuenta? <a href="/register" class="text-black font-bold border-b border-black">Regístrate</a></p>
    </div>
</body>
</html>
